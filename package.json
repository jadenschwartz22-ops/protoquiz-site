{
  "name": "protoquiz-site",
  "version": "1.0.0",
  "description": "ProtoQuiz website and blog",
  "type": "module",
  "scripts": {
    "blog:generate": "node scripts/generate-blog-post.mjs",
    "blog:stats": "node scripts/pull-firestore-stats.mjs",
    "blog:rss": "node scripts/generate-rss-feed.mjs",
    "blog:full": "npm run blog:stats && npm run blog:generate && npm run blog:rss",
    "census:pages": "node scripts/census-pages.mjs",
    "census:report": "node scripts/census-report.mjs",
    "census:indexnow": "node scripts/census-indexnow.mjs",
    "test:census-pages": "node scripts/test-census-pages.mjs",
    "test:census-report": "node scripts/test-census-report.mjs",
    "test:census-indexnow": "node scripts/test-census-indexnow.mjs",
    "test": "npm run test:census-pages && npm run test:census-report && npm run test:census-indexnow && npm run test:shared-chrome && npm run test:practice-pages",
    "test:shared-chrome": "node scripts/test-shared-chrome.mjs",
    "practice:charts": "node scripts/build-practice-charts.mjs",
    "practice:pages": "node scripts/build-practice.mjs && node scripts/build-changes.mjs",
    "practice:build": "npm run practice:charts && npm run practice:pages",
    "test:practice-pages": "node scripts/test-practice-pages.mjs"
  },
  "keywords": [
    "EMS",
    "paramedic",
    "protocols",
    "education"
  ],
  "author": "Jaden Schwartz",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.6.2",
    "firebase-admin": "^13.6.0",
    "glob": "^10.3.10",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.5",
    "yaml": "^2.4.5"
  }
}
